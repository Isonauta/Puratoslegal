// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Ambito {
  SST
  MA
  SGI
  GENERAL
}

enum CumpleEstado {
  SI
  NO
  NO_APLICA
  PENDIENTE
}

enum EvidenceFileStatus {
  POR_GENERAR
  EN_REVISION
  VIGENTE
  VENCIDO
  ACTUALIZAR
}

enum ActionPlanStatus {
  ABIERTO
  EN_CURSO
  CERRADO
  VENCIDO
}

enum StorageProvider {
  SHAREPOINT
  GOOGLE_DRIVE
}

enum DocNorma {
  ISO14001
  ISO45001
  AMBAS
}

// One row per requisito legal from "Matriz Legal".
model LegalRequirement {
  id                 String       @id @default(cuid())
  numero             Int          @unique // "N°" column, stable business key used for cross-sheet references
  tipoRequisito      String // Legal / Otro Requisito / ISO
  tipoDocumento      String // Decreto Supremo, Ley, Resolución, etc.
  documentoNumero    String? // "N°" of the law/decree itself (e.g. 148, 20949)
  nombreLey          String? // Full name/title of the law or decree
  titulo             String
  anioPublicacion    Int?
  organismo          String
  ambito             Ambito
  submateria         String?
  ultimaModificacion String?
  articulo           String?
  requisitoTexto     String? // full legal text / "Requisito Aplica" column
  cumple             CumpleEstado @default(PENDIENTE)
  formaCumplimiento  String?
  formato            String?
  herramientas       String?
  responsable              String?
  estado                   String?
  riesgo                   String?
  oportunidad              String?
  justificacionNoAplica    String?
  clasificacionSIG         String?  // Clasificación de aplicabilidad al SIG: núcleo SST, núcleo ambiental, dual, fuera de alcance, etc.
  fueraAlcanceSIG          Boolean  @default(false) // true = marcado explícitamente fuera del alcance del SIG

  evidenceLinks EvidenceLink[]
  actionPlans   ActionPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ambito])
}

// One row per documento from "Evidencias Generables". Defines WHAT evidence
// should exist; the actual uploaded/linked file lives in EvidenceFile.
model Noticia {
  id          String   @id @default(cuid())
  titulo      String
  contenido   String
  categoria   String?
  autorNombre String
  autorEmail  String
  publicado   Boolean  @default(true)
  destacado   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model EvidenceTemplate {
  id             String  @id @default(cuid())
  codigoSugerido String  @unique // e.g. "R-SST-Contrat-01"
  nombre         String
  tipoEvidencia  String // Procedimiento, Registro / Formato, Programa, etc.
  normativa      String?
  ambito         Ambito?
  submateria     String?
  descripcion    String?

  evidenceLinks EvidenceLink[]
  files         EvidenceFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bridge table: a LegalRequirement can be satisfied by several
// EvidenceTemplates and vice-versa (matriz N° lists like "2, 35, 120-124"
// are expanded into one row per individual requirement number).
model EvidenceLink {
  id                 String           @id @default(cuid())
  legalRequirement   LegalRequirement @relation(fields: [legalRequirementId], references: [id], onDelete: Cascade)
  legalRequirementId String
  evidenceTemplate   EvidenceTemplate @relation(fields: [evidenceTemplateId], references: [id], onDelete: Cascade)
  evidenceTemplateId String

  @@unique([legalRequirementId, evidenceTemplateId])
}

// One row per "Permisos y Autorizaciones" item.
model Permit {
  id                         String    @id @default(cuid())
  numero                     Int       @unique
  categoria                  String
  nombre                     String
  organismoEmisor            String
  baseLegal                  String?
  instalacionAlcance         String?
  periodicidadVencimiento    String?
  consecuenciaIncumplimiento String?
  estadoSugerido             String?
  proximoVencimiento         DateTime?

  files EvidenceFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The actual evidence artifact, linked (not copied) from an external
// document repository such as SharePoint or Google Drive.
model EvidenceFile {
  id         String             @id @default(cuid())
  status     EvidenceFileStatus @default(POR_GENERAR)
  provider   StorageProvider
  externalId String // SharePoint driveItem id / Google Drive file id
  webUrl     String // link the auditor can open
  fileName   String?
  uploadedBy String?
  validFrom  DateTime?
  validUntil DateTime?

  evidenceTemplate   EvidenceTemplate? @relation(fields: [evidenceTemplateId], references: [id], onDelete: Cascade)
  evidenceTemplateId String?
  permit             Permit?           @relation(fields: [permitId], references: [id], onDelete: Cascade)
  permitId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per "Plan de acción" item: a non-conformity raised against a
// LegalRequirement that is not currently met, with its corrective action.
model ActionPlan {
  id                 String            @id @default(cuid())
  noConformidad      Int? // "N° NC"
  // The source "Plan de acción" sheet references the underlying law by
  // document type/number rather than by the Matriz Legal row "N°", and
  // some of those laws are no longer present in the current matrix, so
  // the link to LegalRequirement is best-effort and may be absent.
  legalRequirement   LegalRequirement? @relation(fields: [legalRequirementId], references: [id], onDelete: SetNull)
  legalRequirementId String?
  tipoDocumento      String?
  documentoNumero    String?
  titulo             String
  accionCorrectiva   String
  responsable        String?
  fechaEjecucion     DateTime?
  status             ActionPlanStatus  @default(ABIERTO)
  evidenciaUrl       String?
  evidenciaProvider  StorageProvider?
  evidenciaNombre    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Gestor documental básico: procedimientos, matrices y registros del SGI,
// subidos y descargados directamente (archivo real en Supabase Storage),
// clasificados por punto normativo (4.1, 4.2, ...) para tenerlos listos
// ante una auditoría externa de ISO 14001 / 45001.
enum DocStatus {
  BORRADOR
  EN_REVISION
  EN_APROBACION
  VIGENTE
  RECHAZADO
}

model Documento {
  id              String    @id @default(cuid())
  clausula        String
  clausulaNombre  String
  norma           DocNorma
  tipo            String
  nombre          String
  descripcion     String?
  storagePath     String?
  publicUrl       String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  linkUrl         String?
  linkProvider    StorageProvider?
  subidoPorEmail  String?
  subidoPorNombre String?

  // Workflow documental
  status             DocStatus @default(BORRADOR)
  elaboradorEmail    String?
  elaboradorNombre   String?
  revisorEmail       String?
  revisorNombre      String?
  aprobadorEmail     String?
  aprobadorNombre    String?
  contenido          String?
  versionCode        String?
  vigenciaDesde      DateTime?
  proximaRevision    DateTime?  // vigenciaDesde + 1 year, computed on approval

  revisiones         DocRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clausula])
  @@index([norma])
  @@index([status])
}

model DocRevision {
  id                  String    @id @default(cuid())
  documentoId         String
  documento           Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  accion              String
  autorEmail          String
  autorNombre         String
  comentario          String?
  descripcionCambios  String?   // what changed in this revision
  sinCambios          Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@index([documentoId])
}

// =============================================================================
// PTS — Permiso de Trabajo Seguro (F-SHE-G-001 v02)
// =============================================================================

enum UserRole {
  SOLICITANTE
  SUPERVISOR
  SHE
  CONTRATISTA
  ADMIN
}

enum PermitStatus {
  BORRADOR
  ENVIADO_A_APROBACION
  APROBADO_SUPERVISOR
  AUTORIZADO_SHE
  EN_CURSO
  CERRADO
  SUSPENDIDO
  ANULADO
}

enum Shift {
  DIA
  TARDE
  NOCHE
}

enum PermitType {
  ALTURA_FISICA
  TRABAJO_CALIENTE
  ESPACIO_CONFINADO
  LOTO_BLOQUEO_ENERGIA
  EXCAVACION_ZANJAS
  TRABAJOS_ELECTRICOS
  IZAJE_GRUA
  TRABAJOS_NOCTURNOS
  OTRO
}

enum HazardType {
  TRABAJO_ALTURA_FISICA
  CAIDA_MISMO_DISTINTO_NIVEL
  TRABAJO_CALIENTE
  ESPACIO_CONFINADO
  ENERGIA_PELIGROSA_LOTO
  CONTACTO_ELECTRICIDAD
  EXPOSICION_RUIDO
  EXPOSICION_RADIACION_UV
  EXPOSICION_QUIMICOS
  PROYECCION_PARTICULAS
  CILINDROS_PRESION
  ILUMINACION_DEFICIENTE
  SUPERFICIE_DEFECTUOSA
  TRASLADO_MATERIALES
  SOBRESFUERZO_FISICO
  APRISIONAMIENTO
  GOLPEADO_POR_CONTRA_OBJETO
  INCENDIO_EXPLOSION
  LIBERACION_GAS_ENERGIA
  HERR_ELECTRICAS_MANUALES
  POSICION_INCORRECTA
  LINEAS_ENERGIZADAS_CERCANAS
  DEFICIENCIA_O2
  OTRO
}

enum ControlMeasure {
  ATS_APLICADO_ANTES_INICIAR
  DELIMITACION_SENALIZACION
  BLOQUEO_LOTO_EJECUTADO
  PERMISO_ESPACIO_CONFINADO
  ARNES_DOS_COLAS_VIDA
  VIGIA_RESCATISTA_DESIGNADO
  EXTENSIONES_ELECTRICAS_OK
  HERRAMIENTAS_INSPECCIONADAS
  ILUMINACION_ADECUADA
  VENTILACION_ADECUADA
  COORD_CON_CLIENTE_REALIZADA
  PAUSAS_ROTACION_PERSONAL
  CERT_MEDICO_ALTURA_VIGENTE
  CAPACITACION_TAREA_ESPECIFICA
  HOJAS_SEGURIDAD_DISPONIBLES
  ORDEN_ASEO_AREA
  LEVANTE_25KG_INDIVIDUAL
  TRABAJO_CON_AYUDANTE
  DETENER_ANTE_PELIGRO
  TRANSITO_VIAS_EXPEDITAS
  PLAN_EMERGENCIA_CONOCIDO
  PROTEGER_AREAS_DERRAMES
  INSPECCIONAR_HERR_EQUIPOS
  OTRO
}

enum PpeType {
  CASCO_SEGURIDAD
  ZAPATOS_BOTINES_SEGURIDAD
  LENTES_SEGURIDAD
  PROTECCION_OCULAR_LATERAL_SUPERIOR
  CARETA_ROSTRO_COMPLETO
  PROTECCION_AUDITIVA
  RESPIRADOR_POLVO_VAPORES
  GUANTES
  ROPA_TRABAJO_OVEROL
  ROPA_RETARDANTE_FUEGO
  ARNES_LINEA_VIDA
  EQUIPO_ESPECIAL_SOLDADURA
  CREMA_PROTECCION_UV
  CHALECO_REFLECTANTE
  OTRO
}

enum GasType {
  O2
  CO
  H2S
  LEL
}

enum SignatureRole {
  SOLICITANTE
  SUPERVISOR_APRUEBA
  SHE_AUTORIZA
  SUPERVISOR_RECEPCIONA_CIERRE
  ATS_RESPONSABLE
  ATS_SUPERVISOR_VALIDA
  ATS_TRABAJADOR
  PTS_TRABAJADOR
}

enum AreaCondition {
  LIMPIA_Y_SEGURA
  CON_OBSERVACIONES
}

enum PotentialIncidentType {
  CAIDA_ALTURA
  CAIDA_MISMO_NIVEL
  QUEMADURA
  ASFIXIA_INTOXICACION
  ELECTROCUCION
  ATRAPAMIENTO
  GOLPE_OBJETO
  CORTE_LACERACION
  EXPLOSION_INCENDIO
  EXPOSICION_QUIMICA
  SOBRESFUERZO_LESION_MUSCULAR
  DERRUMBE_COLAPSO
  OTRO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  rut          String?
  role         UserRole @default(ADMIN)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permitsCreated    WorkPermit[]      @relation("PermitSolicitante")
  permitsSupervised WorkPermit[]      @relation("PermitSupervisor")
  statusTransitions PermitStatusLog[]
  signatures        Signature[]
  atsCreated        ATS[]             @relation("ATSResponsable")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  rut       String   @unique
  createdAt DateTime @default(now())

  users       User[]
  workPermits WorkPermit[]
}

model WorkPermit {
  id           String @id @default(cuid())
  permitNumber Int    @unique @default(autoincrement())

  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  companyRut        String
  date              DateTime
  area              String
  shift             Shift
  startTime         DateTime
  endTime           DateTime
  taskDescription   String
  solicitanteId     String
  solicitante       User     @relation("PermitSolicitante", fields: [solicitanteId], references: [id])
  supervisorId      String?
  supervisor        User?    @relation("PermitSupervisor", fields: [supervisorId], references: [id])
  contractorCompany String?
  workerCount       Int      @default(0)

  permitTypes         PermitType[]
  permitTypeOtherText String?
  hazards             HazardType[]
  hazardOtherText     String?
  controlMeasures     ControlMeasure[]
  controlMeasureOtherText String?
  ppeRequired         PpeType[]
  ppeGlovesType       String?
  ppeOtherText        String?
  ppeObservations     String?

  actualEndTime     DateTime?
  areaCondition     AreaCondition?
  closeObservations String?

  status PermitStatus @default(BORRADOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers            Worker[]
  atmosphereReadings AtmosphereReading[]
  signatures         Signature[]
  statusLogs         PermitStatusLog[]
  atsList            ATS[]
}

model PermitStatusLog {
  id           String        @id @default(cuid())
  workPermitId String
  workPermit   WorkPermit    @relation(fields: [workPermitId], references: [id], onDelete: Cascade)
  fromStatus   PermitStatus?
  toStatus     PermitStatus
  changedById  String
  changedBy    User          @relation(fields: [changedById], references: [id])
  comment      String?
  createdAt    DateTime      @default(now())
}

model Worker {
  id                        String     @id @default(cuid())
  workPermitId              String
  workPermit                WorkPermit @relation(fields: [workPermitId], references: [id], onDelete: Cascade)
  order                     Int
  fullName                  String
  rut                       String
  position                  String
  company                   String
  hasAltitudeMedicalCert    Boolean    @default(false)
  altitudeMedicalCertExpiry DateTime?
  inductionCompleted        Boolean    @default(false)
  signatureImage            String?
  signedAt                  DateTime?
  createdAt                 DateTime   @default(now())
}

model AtmosphereReading {
  id              String     @id @default(cuid())
  workPermitId    String
  workPermit      WorkPermit @relation(fields: [workPermitId], references: [id], onDelete: Cascade)
  gas             GasType
  reading1        Float?
  reading2        Float?
  reading3        Float?
  instrument      String?
  responsibleName String?
  createdAt       DateTime   @default(now())
}

model Signature {
  id         String        @id @default(cuid())
  role       SignatureRole
  signerName String
  signerRut  String?
  imageData  String
  signedAt   DateTime      @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  workPermitId String?
  workPermit   WorkPermit? @relation(fields: [workPermitId], references: [id], onDelete: Cascade)

  atsId String?
  ats   ATS?    @relation(fields: [atsId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
}

model ATS {
  id String @id @default(cuid())

  workPermitId String?
  workPermit   WorkPermit? @relation(fields: [workPermitId], references: [id])

  companyName     String
  area            String
  date            DateTime
  startTime       DateTime
  endTime         DateTime
  taskDescription String

  responsibleId String
  responsible   User   @relation("ATSResponsable", fields: [responsibleId], references: [id])

  supervisorValidatesName String?
  supervisorValidatesRut  String?

  highRiskProcedures     PermitType[]
  potentialIncidents     PotentialIncidentType[]
  potentialIncidentOther String?
  controlMeasures        ControlMeasure[]
  controlMeasureOther    String?
  ppeRequired            PpeType[]
  ppeOtherText           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps      ATSStep[]
  workers    ATSWorker[]
  signatures Signature[]
}

model ATSStep {
  id                 String   @id @default(cuid())
  atsId              String
  ats                ATS      @relation(fields: [atsId], references: [id], onDelete: Cascade)
  order              Int
  taskStage          String
  hazardsExposed     String
  potentialIncidents String
  controls           String
  createdAt          DateTime @default(now())
}

model ATSWorker {
  id                String    @id @default(cuid())
  atsId             String
  ats               ATS       @relation(fields: [atsId], references: [id], onDelete: Cascade)
  order             Int
  fullName          String
  rut               String
  medicalCertExpiry DateTime?
  signatureImage    String?
  signedAt          DateTime?
  createdAt         DateTime  @default(now())
}

model Video {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  youtubeUrl  String
  orden       Int      @default(0)
  publicado   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Termino {
  id         String   @id @default(cuid())
  termino    String
  definicion String
  orden      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Politica {
  id        String   @id @default(cuid())
  titulo    String
  tipo      String
  contenido String?
  pdfUrl    String?
  publicado Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
